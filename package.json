{
  "name": "burnout-spa",
  "version": "0.1.0",
  "private": true,
  "description": "Burnout in Tech SPA built with React + Vite",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phajsi/burnout-spa.git"
  },
  "bugs": {
    "url": "https://github.com/phajsi/burnout-spa/issues"
  },
  "homepage": "https://github.com/phajsi/burnout-spa#readme",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": "11.17.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "react-scroll-parallax": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "build:clean": "rm -rf dist && vite build",
    "build:check": "node scripts/check-build.cjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:build": "pnpm run build && pnpm run build:verify",
    "build:verify": "node scripts/check-build.cjs",
    "lint:types": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "prepare": "husky"
  }
}
